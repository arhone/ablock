{
    "manifest_version": 3,
    "name": "__MSG_extName__",
    "description": "__MSG_extDescription__",
    "default_locale": "en",
    "version": "4.0.2",
    "author": "Алексей Арх",
    "minimum_chrome_version": "111",
    "icons": {
        "32": "images/ablock-32.png",
        "128": "images/ablock-128.png"
    },
    "background": {
        "service_worker": "background/sw.js"
    },
    "permissions": [
        "storage",
        "scripting",
        "activeTab",
        "declarativeNetRequest"
    ],
    "host_permissions": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.pornhub.com/*",
        "*://*.pornhub.org/*",
        "*://*.vk.com/*",
        "*://*.vk.ru/*",
        "*://*.vkvideo.ru/*",
        "*://*.ok.ru/*"
    ],
    "optional_permissions": [
        "webRequest",
        "browsingData"
    ],
    "optional_host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_title": "__MSG_extName__",
        "default_icon": {
            "32": "images/ablock-32.png"
        },
        "default_popup": "popup/popup.html"
    },
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ads",
                "enabled": true,
                "path": "rules/ads.json"
            },
            {
                "id": "trackers",
