{
    "name": "ablock",
    "private": true,
    "description": "Инструменты разработки ABlock: линтеры и типы. В само расширение не входят.",
    "scripts": {
        "lint": "npm run lint:js && npm run lint:css",
        "lint:js": "eslint .",
        "lint:css": "stylelint \"src/**/*.css\"",
        "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/chrome": "^0.3.5",
        "eslint": "^9.39.5",
        "globals": "^16.5.0",
        "stylelint": "^16.26.1",
        "stylelint-config-recommended": "^16.0.0"
    }
}
