{
    "manifest_version": 3,
    "name": "ABlock - Блокировщик рекламы",
    "description": "Прицельная блокировка рекламы и трекеров",
    "version": "3.0.1",
    "author": "Алексей Арх",
    "minimum_chrome_version": "111",
    "icons": {
        "32": "image/ablock-32.png",
        "128": "image/ablock-128.png"
    },
    "background": {
        "service_worker": "js/sw.js"
    },
    "permissions": [
        "storage",
        "scripting",
        "activeTab",
        "declarativeNetRequest"
    ],
    "host_permissions": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.pornhub.com/*",
        "*://*.pornhub.org/*",
        "*://*.vk.com/*",
        "*://*.vk.ru/*",
        "*://*.vkvideo.ru/*",
        "*://*.ok.ru/*"
    ],
    "action": {
        "default_title": "ABlock - Блокировщик рекламы",
        "default_icon": {
            "32": "image/ablock-32.png"
        },
        "default_popup": "popup.html"
    },
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ads",
                "enabled": true,
                "path": "rules/ads.json"
            },
            {
                "id": "trackers",
                "enabled": true,
                "path": "rules/trackers.json"
            },
            {
                "id": "ru-ads",
                "enabled": true,
                "path": "rules/ru-ads.json"
            },
            {
                "id": "ru-trackers",
                "enabled": true,
                "path": "rules/ru-trackers.json"
            },
            {
                "id": "youtube.com",
                "enabled": true,
                "path": "rules/youtube.com.json"
            },
            {
                "id": "pornhub.com",
                "enabled": true,
                "path": "rules/pornhub.com.json"
            },
            {
                "id": "xvideos.com",
                "enabled": true,
                "path": "rules/xvideos.com.json"
            },
            {
                "id": "vk.com",
                "enabled": true,
                "path": "rules/vk.com.json"
            },
            {
                "id": "ok.ru",
                "enabled": true,
                "path": "rules/ok.ru.json"
            },
            {
                "id": "yandex.ru",
                "enabled": true,
                "path": "rules/yandex.ru.json"
            },
            {
                "id": "rambler.ru",
                "enabled": true,
                "path": "rules/rambler.ru.json"
            },
            {
                "id": "anime",
                "enabled": true,
                "path": "rules/anime.json"
            },
            {
                "id": "other",
                "enabled": true,
                "path": "rules/other.json"
            },
            {
                "id": "easylist",
                "enabled": true,
                "path": "rules/lists/easylist.json"
            },
            {
                "id": "easyprivacy",
                "enabled": true,
                "path": "rules/lists/easyprivacy.json"
            },
            {
                "id": "ublock-filters",
                "enabled": true,
                "path": "rules/lists/ublock-filters.json"
            },
            {
                "id": "pgl",
                "enabled": true,
                "path": "rules/lists/pgl.json"
            },
            {
                "id": "ublock-badware",
                "enabled": true,
                "path": "rules/lists/ublock-badware.json"
            },
            {
                "id": "rus-0",
                "enabled": true,
                "path": "rules/lists/rus-0.json"
            },
            {
                "id": "rus-1",
                "enabled": true,
                "path": "rules/lists/rus-1.json"
            }
        ]
    }
}
